# Run Services
exec udiskie --no-automount --tray
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec mako
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=pkcs11,secrets,ssh
exec fcitx5 -d
# exec waybar

set $bg       #1f1f1f
set $active   #333333
set $inactive #333333
set $text_color   #ffffff

# class                 border     background  text         indicator  child_border
client.focused          $active    $bg         $text_color  $active    $active
client.focused_inactive $inactive  $bg         $text_color  $inactive  $inactive
client.unfocused        $bg        #0d1117     #888888      $bg        $inactive
client.urgent           #e06c75    #e06c75     $text_color  #e06c75    #e06c75
client.placeholder      #000000    #0c0c0c     $text_color  #000000    #0c0c0c


# Border
default_border pixel 1
default_floating_border pixel 1
#smart_borders on

# Konfigurasi Monitor: eDP-1 di kiri, HDMI di kanan
output eDP-1 position 0 0 resolution 1920x1200@59.999Hz
output HDMI-A-1 position 1920 0 resolution 1920x1080@74.973Hz

gaps inner 12
gaps outer 80

# Font
font pango:SauceCodePro Nerd Font 12

# Mod1 for Alt.
# Mod4 for Home.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Apps
# set $term kitty
set $term foot
set $menu dmenu_run -l 10 -p "Run: " -nb "#0d1117" -nf "#ffffff" -sb "#2c3b4e" -sf "#ffffff"
set $browser firefox
set $filemanager nautilus
set $displayManager wdisplays
set $discord discord

# Wallpaper
output * bg ~/dotfiles/wallpapers/cube.jpg fill

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
include ~/.config/sway/swayfx
